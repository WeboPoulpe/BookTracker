# Copier en .env.local et renseigner. .env.local n'est jamais committé.

# Neon — driver HTTP, région eu-west-2
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js v5 — générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Mode mono-utilisateur : l'app tourne sans OAuth tant que ce drapeau est à "true"
NEXT_PUBLIC_MODE_LOCAL="true"
UTILISATEUR_LOCAL_ID="local"
UTILISATEUR_LOCAL_EMAIL="moi@exemple.fr"
# Nom affiché dans le bonjour de l'accueil
UTILISATEUR_LOCAL_NOM="Morgane"
